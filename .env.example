# Copy this file to .env and replace placeholders with local values.
# Do not commit your .env file.

# SYS/SYSTEM password required by the Oracle Free image startup
ORACLE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Host port mapped to Oracle container port 1521
ORACLE_HOST_PORT=1522

# Application schema credentials used by the backend connection string
ORACLE_APP_USER=astrotrack
ORACLE_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
